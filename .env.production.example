# Copy to .env.production and replace ALL placeholder values before deploy

# === DJANGO SETTINGS ===
DEBUG=False
DJANGO_SECRET_KEY=change-this-with-a-long-random-secret
DJANGO_SETTINGS_MODULE=config.settings
ENVIRONMENT=production
SPECTACULAR_DISABLE_WARNINGS=True
APP_LOG_LEVEL=INFO
CORE_LOG_LEVEL=INFO

# === DATABASE ===
DB_ENGINE=postgresql
DB_NAME=hospitoll_db
DB_USER=hospitoll_user
DB_PASSWORD=change-this-secure-password
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=120
HOSPITOLL_ADMIN_PASSWORD=change-this-admin-db-role-password
HOSPITOLL_APP_PASSWORD=change-this-app-db-role-password

# === CELERY & REDIS ===
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CACHE_LOCATION=redis://redis:6379/1
CHANNEL_REDIS_URL=redis://redis:6379/2
USE_REDIS_CACHE=True
SEND_EMAILS_ASYNC=True
CELERY_WORKER_CONCURRENCY=2
CELERY_WORKER_MAX_TASKS_PER_CHILD=200
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# === CORS & FRONTEND ===
DOMAIN=g-med.uz
ALLOWED_HOSTS=g-med.uz,www.g-med.uz
CORS_ALLOWED_ORIGINS=https://g-med.uz,https://www.g-med.uz
CSRF_TRUSTED_ORIGINS=https://g-med.uz,https://www.g-med.uz
FRONTEND_URL=https://g-med.uz
ADMIN_URL=secure-admin/
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100

# === TELEGRAM BOT ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=hosptol_bot
TELEGRAM_WEBHOOK_SECRET=change-this-random-secret
ADMIN_TELEGRAM_URL=https://t.me/JXgroup_bot

# === EMAIL CONFIGURATION ===
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=mailer@g-med.uz
EMAIL_HOST_PASSWORD=change-this-mail-password
DEFAULT_FROM_EMAIL=noreply@g-med.uz
SERVER_EMAIL=noreply@g-med.uz

# === SECURITY ===
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# === OBSERVABILITY ===
SENTRY_DSN=
